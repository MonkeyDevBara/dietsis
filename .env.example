# Copy to .env (frontend, read by Vite) and export the DIETSIS_* values for the Go server.
# Never commit real values. See docs/ARCHITECTURE.md#konfigurasi.

# --- Frontend (build time) ---
# Google OAuth Web client ID (public identifier, not a secret).
VITE_GOOGLE_CLIENT_ID=

# --- Backend ---
DIETSIS_ENV=development
DIETSIS_ADDR=127.0.0.1:8787
DIETSIS_DB_PATH=./data/dietsis.db
DIETSIS_GOOGLE_CLIENT_ID=
DIETSIS_PUBLIC_ORIGIN=http://localhost:5178
DIETSIS_COOKIE_SECURE=false
DIETSIS_SESSION_TTL=720h
DIETSIS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
DIETSIS_BACKUP_DIR=./data/backups
DIETSIS_BACKUP_KEEP=14
